# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Supabase SESSION-pooler connection string (port 5432, sslmode=require).
# Long import transactions do not belong on the transaction pooler (6543).
# Local dev stand-in (root docker-compose.yml, plain Postgres 16):
SUPABASE_DB_URL="postgresql://fundpro:fundpro_dev_only@localhost:5433/fundpro"
# SUPABASE_DB_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Bearer token the Next.js server sends on every request.
# Generate with: openssl rand -hex 32
API_KEY="replace-me-with-openssl-rand-hex-32"

LOG_LEVEL="INFO"
