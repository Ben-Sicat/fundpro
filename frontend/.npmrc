# The npm registry is reachable over IPv6 only here and is slow (~30KB/s).
# Large tarballs (next, typescript, swc, sharp) exceed pnpm's default timeout,
# so allow far longer fetches, more retries, and fewer parallel sockets
# (high concurrency on a slow link starves every socket at once).
fetch-timeout=1800000
fetch-retries=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
network-concurrency=4
