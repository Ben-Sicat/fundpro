# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env / .env.local.
# ---------------------------------------------------------------------------

# Local Docker Postgres 16 (docker-compose.yml). Port 5433 avoids clashing with
# any host Postgres already on 5432.
DATABASE_URL="postgresql://fundpro:fundpro_dev_only@localhost:5433/fundpro"

# Neon (dev branch / production). Swap DATABASE_URL to this to use Neon.
# Neon requires sslmode=require.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/fundpro?sslmode=require"

# Auth.js v5. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Shared secret for cron/job endpoints (Vercel cron sends it as a Bearer token).
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-me-with-openssl-rand-hex-32"

# Job driver: "vercel-cron" (Neon/Vercel, default) or "pg-boss" (VPS + Docker).
JOB_DRIVER="vercel-cron"

# Initial admin created by `pnpm db:seed`.
SEED_ADMIN_EMAIL="admin@fundpro.local"
SEED_ADMIN_PASSWORD="ChangeMe!123"
